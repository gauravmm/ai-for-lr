{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/docgen/attribution.schema.json",
  "title": "Student claim-to-source attribution table",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "rows"],
  "properties": {
    "schema_version": {"const": 1},
    "case_id": {"const": "ARER-300-2026"},
    "rows": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["claim_id", "claim_text", "source_id", "source_locator", "source_value", "transformation", "result", "documentary_status", "verification_status"], "properties": {"claim_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]+$"}, "claim_text": {"type": "string", "minLength": 3}, "source_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3}$"}, "source_locator": {"type": "string", "minLength": 3}, "source_value": {"type": ["string", "number", "boolean", "null"]}, "transformation": {"type": "string", "minLength": 3}, "result": {"type": ["string", "number", "boolean", "null"]}, "documentary_status": {"enum": ["signed", "submitted", "approved", "formal_addendum", "clarification", "evaluation", "generated_summary", "restricted"]}, "verification_status": {"enum": ["supported", "contradicted", "unsupported", "unresolved"]}}}}
  }
}
