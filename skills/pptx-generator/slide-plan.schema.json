{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/encabulation/slide-plan.schema.json",
  "title": "Encabulation leadership slide-deck plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "audience", "sources", "slides"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "audience": { "type": "string", "minLength": 3, "maxLength": 60 },
    "sources": {
      "type": "array", "minItems": 0, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["documentId", "locator"],
        "properties": {
          "documentId": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,24}$" },
          "locator": { "type": "string", "minLength": 2, "maxLength": 75 }
        }
      }
    },
    "slides": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {
        "oneOf": [
          {
            "type": "object", "additionalProperties": false,
            "required": ["archetype", "title", "gates", "comparison"],
            "properties": {
              "archetype": { "enum": ["decision_summary", "gate_focus"] },
              "title": { "type": "string", "minLength": 5, "maxLength": 100 },
              "recommendation": { "type": "string", "minLength": 5, "maxLength": 150 },
              "decision": { "type": "string", "minLength": 5, "maxLength": 150 },
              "gates": {
                "type": "array", "minItems": 2, "maxItems": 5,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["vendor", "status", "reason"],
                  "properties": {
                    "vendor": { "type": "string", "minLength": 2, "maxLength": 40 },
                    "status": { "enum": ["PASS", "FAIL", "UNVERIFIED"] },
                    "reason": { "type": "string", "minLength": 3, "maxLength": 75 }
                  }
                }
              },
              "comparison": {
                "type": "array", "minItems": 1, "maxItems": 3,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["vendor", "score", "label"],
                  "properties": {
                    "vendor": { "type": "string", "minLength": 2, "maxLength": 40 },
                    "score": { "type": "number", "minimum": 0, "maximum": 100, "multipleOf": 0.1 },
                    "label": { "type": "string", "minLength": 3, "maxLength": 38 }
                  }
                }
              }
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["archetype", "title", "problem", "mandatoryGates", "criteria"],
            "properties": {
              "archetype": { "const": "context" },
              "title": { "type": "string", "minLength": 5, "maxLength": 100 },
              "problem": { "type": "string", "minLength": 20, "maxLength": 320 },
              "mandatoryGates": {
                "type": "array", "minItems": 5, "maxItems": 7,
                "items": { "type": "string", "minLength": 5, "maxLength": 85 }
              },
              "criteria": {
                "type": "array", "minItems": 2, "maxItems": 4,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["name", "weight"],
                  "properties": {
                    "name": { "type": "string", "minLength": 3, "maxLength": 26 },
                    "weight": { "type": "number", "minimum": 0, "maximum": 100 }
                  }
                }
              }
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["archetype", "title", "subtitle"],
            "properties": {
              "archetype": { "const": "cover" },
              "title": { "type": "string", "minLength": 5, "maxLength": 45 },
              "subtitle": { "type": "string", "minLength": 3, "maxLength": 80 }
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["archetype", "title", "summary", "facts"],
            "properties": {
              "archetype": { "const": "overview" },
              "title": { "type": "string", "minLength": 5, "maxLength": 100 },
              "summary": { "type": "string", "minLength": 20, "maxLength": 240 },
              "facts": {
                "type": "array", "minItems": 2, "maxItems": 4,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["label", "value"],
                  "properties": {
                    "label": { "type": "string", "minLength": 3, "maxLength": 24 },
                    "value": { "type": "string", "minLength": 2, "maxLength": 40 }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
