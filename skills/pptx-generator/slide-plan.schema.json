{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/encabulation/slide-plan.schema.json",
  "title": "Encabulation leadership slide plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "archetype", "audience", "title", "recommendation", "decision", "gates", "comparison", "sources"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "archetype": { "enum": ["decision_summary", "gate_focus", "comparison_focus"] },
    "audience": { "type": "string", "minLength": 3, "maxLength": 60 },
    "title": { "type": "string", "minLength": 5, "maxLength": 100 },
    "recommendation": { "type": "string", "minLength": 5, "maxLength": 150 },
    "decision": { "type": "string", "minLength": 5, "maxLength": 150 },
    "gates": {
      "type": "array", "minItems": 2, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["vendor", "status", "reason"],
        "properties": {
          "vendor": { "type": "string", "minLength": 2, "maxLength": 40 },
          "status": { "enum": ["PASS", "FAIL", "UNVERIFIED"] },
          "reason": { "type": "string", "minLength": 3, "maxLength": 75 }
        }
      }
    },
    "comparison": {
      "type": "array", "minItems": 2, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["vendor", "score", "label"],
        "properties": {
          "vendor": { "type": "string", "minLength": 2, "maxLength": 40 },
          "score": { "type": "number", "minimum": 0, "maximum": 100, "multipleOf": 0.1 },
          "label": { "type": "string", "minLength": 3, "maxLength": 38 }
        }
      }
    },
    "sources": {
      "type": "array", "minItems": 2, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["documentId", "locator"],
        "properties": {
          "documentId": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,24}$" },
          "locator": { "type": "string", "minLength": 2, "maxLength": 75 }
        }
      }
    }
  }
}
