{
  "name": "AI for CLM student workshop",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "updateContentCommand": "python3 .course/course.py dependencies",
  "postCreateCommand": "python3 .course/course.py setup",
  "postStartCommand": {
    "course": "python3 .course/course.py start",
    "firetruck": "python3 firetruck/start.py"
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Firetruck simulator",
      "onAutoForward": "silent",
      "protocol": "http"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code@2.1.283",
        "mathematic.vscode-pdf@0.2.6"
      ],
      "settings": {
        "extensions.autoUpdate": false,
        "extensions.autoCheckUpdates": false,
        "chat.disableAIFeatures": true,
        "chat.commandCenter.enabled": false,
        "chat.agent.enabled": false,
        "github.copilot.enable": {
          "*": false
        },
        "workbench.secondarySideBar.defaultVisibility": "visible",
        "claudeCode.preferredLocation": "sidebar",
        "task.allowAutomaticTasks": "on"
      }
    }
  },
  "shutdownAction": "stopContainer"
}
